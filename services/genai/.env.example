# Eprodux GenAI Service — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# ── Service ────────────────────────────────────────────────────────────────
PORT=8002
LOG_LEVEL=INFO

# ── Demo / Fallback mode ───────────────────────────────────────────────────
# Set to true to use mock data and pre-computed responses (no API key needed).
# Set to false only when real twin backend and Claude API are available.
DEMO_MODE=true

# ── Claude / Anthropic API ─────────────────────────────────────────────────
# Leave blank to run entirely in fallback/demo mode without LLM calls.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-5-haiku-20241022
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2

# ── Twin / Backend integration ─────────────────────────────────────────────
# INTEGRATION-TODO: confirm URL and path with twin/backend member (Member 2).
TWIN_BACKEND_URL=http://localhost:8001
TWIN_SUMMARY_PATH=/api/twin/summary
TWIN_TIMEOUT_SECONDS=5.0

# ── Savings calculation constants ──────────────────────────────────────────
# These are illustrative estimates. Update after confirming with project team.
# Emissions factor: India CEA average grid intensity (kg CO2/kWh)
EMISSIONS_FACTOR_KG_PER_KWH=0.82
# Electricity tariff (INR/kWh) — adjust for your utility/campus rate
TARIFF_INR_PER_KWH=8.0

# ── RAG ────────────────────────────────────────────────────────────────────
KNOWLEDGE_DIR=rag/knowledge
RAG_INDEX_PATH=rag/.index_cache
RAG_TOP_K=3
