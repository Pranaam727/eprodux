# =============================================================
# Eprodux Frontend – Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env with real secrets.
# =============================================================

# Demo mode (default: true)
# Set to "false" to attempt connection to real backend services.
# When "true", all data is simulated and clearly labeled.
VITE_DEMO_MODE=true

# Backend API base URL (used when VITE_DEMO_MODE=false)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for live Twin push events (used when VITE_DEMO_MODE=false)
VITE_WS_URL=ws://localhost:8000/ws
