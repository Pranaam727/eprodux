# Eprodux Digital Twin Environment Configuration (Example)
# Copy to .env for local runtime customization. DO NOT commit real secrets or production credentials.

# Service Binding
TWIN_HOST=0.0.0.0
TWIN_PORT=8000
TWIN_LOG_LEVEL=INFO

# Operational Mode: mock | live | replay
TWIN_RUN_MODE=mock

# Building Configuration Path (relative to repository root or absolute)
TWIN_BUILDING_CONFIG_PATH=contracts/building.json

# Safety & Anomaly Detection Thresholds (Prototype settings, not building safety standards)
TWIN_STALE_THRESHOLD_SECONDS=30.0
TWIN_IDLE_LIT_THRESHOLD_SECONDS=120.0
TWIN_MIN_CONFIDENCE_THRESHOLD=0.70

# TimescaleDB & MQTT Integration Placeholders (For subsequent checkpoints)
# TIMESCALE_DATABASE_URL=postgresql://eprodux_user:eprodux_pass@localhost:5432/eprodux_twin
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883
# MQTT_OCCUPANCY_TOPIC=eprodux/events/cv/#
